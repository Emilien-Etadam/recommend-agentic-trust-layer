# Copy to .env, uncomment what you use. caddy-gui reads this file before the first
# deploy and shows these as optional fields (a commented value is only an example).
# Cloud providers (Gemini, Exa, SerpAPI, Parallel) still work through the same env
# variables; they are documented in the README, not here, to keep this form short.

# OpenAI-compatible server: llama-swap, llama.cpp, Ollama, vLLM.
# LLM_BASE_URL=http://192.168.1.10:8080/v1
# Model name as declared in your llama-swap config.yaml (14B-class, 16k context).
# LLM_MODEL=qwen3-14b
# Bearer token, only if the server was started with --api-key (401 otherwise).
# LLM_API_KEY=
# Set 3 for a "thinking" model so the reasoning fits in the token budget.
# LLM_MAX_TOKENS_MULT=1
# SearXNG instance; its JSON API must be on (settings.yml → search.formats: [html, json]).
# SEARXNG_URL=http://192.168.1.20:8080
# Byparr (FlareSolverr-compatible), reads pages that refuse a plain GET. Optional.
# BYPARR_URL=http://192.168.1.21:8191
