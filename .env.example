# Copy this file to .env, uncomment what you use, fill it in.
# Convention (also read by caddy-gui before the first deploy): a variable left empty
# is required; one with a value is optional with that default; a commented one is
# optional and its value is only an example.
# Nothing here is strictly required: the model is EITHER a local server (LLM_BASE_URL)
# OR Gemini (GEMINI_API_KEY); the web lanes are EITHER SearXNG OR Exa + SerpAPI.
# The startup banner tells you what is missing.

# ── The model: judge, structurer, narrator ───────────────────────────────────
# Option A — local, any OpenAI-compatible server (llama-swap, llama.cpp, Ollama, vLLM).
# Takes precedence over Gemini when set.
# LLM_BASE_URL=http://192.168.1.10:8080/v1
# Model name as declared in your llama-swap config.yaml. 14B-class, 16k context minimum.
# LLM_MODEL=qwen3-14b
# Bearer token, only if your server enforces one.
# LLM_API_KEY=
# Seconds per call; the first call may wait for a model swap.
# LLM_TIMEOUT=300
# Set 3 or 4 for a "thinking" model so the reasoning fits in the budget.
# LLM_MAX_TOKENS_MULT=1
# Label shown in the UI next to the blind-model verdict.
# LLM_PROVIDER_LABEL=llama-swap

# Option B — Gemini. Free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Or Vertex AI with a service account instead of the key.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GEMINI_LOCATION=global
# GEMINI_MODEL=gemini-3.1-flash-lite

# ── Evidence lanes ───────────────────────────────────────────────────────────
# Option A — local. SearXNG instance; its JSON API must be on
# (settings.yml → search: { formats: [html, json] }).
# SEARXNG_URL=http://192.168.1.20:8080
# Comma list of engines; default = the instance defaults.
# SEARXNG_ENGINES=google,bing,duckduckgo
# SEARXNG_LANGUAGE=all
# Byparr (FlareSolverr-compatible) reads pages that refuse a plain GET. Optional.
# BYPARR_URL=http://192.168.1.21:8191
# Seconds per page through Byparr.
# BYPARR_TIMEOUT=45
# Concurrent Byparr requests.
# FETCH_BYPARR_MAX=4

# Option B — cloud. Exa powers the Grounded Web, Semantic Web and fast Deep Research lanes.
# https://exa.ai · ~$0.005–0.007 per call
# EXA_API_KEY=
# SerpAPI — the Live Index lane (Google results + answer box). https://serpapi.com
# SERPAPI_API_KEY=
# Parallel.ai — the heavyweight Deep Research lane (only with DEEP_ENGINE=parallel).
# PARALLEL_API_KEY=

# ── Server knobs ─────────────────────────────────────────────────────────────
# PORT, HOST and DATA_DIR are set by the systemd unit under caddy-gui; set them only
# when running by hand.
# PORT=8899
# HOST=127.0.0.1
# DATA_DIR=/var/lib/trust-layer
# Switch the deep lane to Parallel.ai (~70s, better citations).
# DEEP_ENGINE=parallel
# Spend guard: checks per IP per day.
# PER_IP_DAY=25
# Spend guard: checks per instance per day.
# GLOBAL_DAY=400
# How often tracked claims are re-checked, in hours.
# TRACK_EVERY_H=24
