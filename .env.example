# Copy this file to .env and fill in what you have.
# A lane whose key is missing simply sits the check out — the minimum working
# setup is GEMINI_API_KEY + EXA_API_KEY.

# ── Gemini (REQUIRED — the judge, the structurer, the narrator) ──────────────
# Easiest path: a free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# …or, instead of the API key, use Vertex AI with a service account:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GEMINI_LOCATION=global

# Model override (optional)
# GEMINI_MODEL=gemini-3.1-flash-lite

# ── Evidence lanes ───────────────────────────────────────────────────────────
# Exa — powers the Grounded Web, Semantic Web and (fast) Deep Research lanes.
# https://exa.ai  ·  ~$0.005–0.007 per call
EXA_API_KEY=

# SerpAPI — the Live Index lane (Google results + answer box). https://serpapi.com
SERPAPI_API_KEY=

# Parallel.ai — the heavyweight Deep Research lane (only used with DEEP_ENGINE=parallel).
# https://parallel.ai
PARALLEL_API_KEY=

# ── Server knobs (optional) ──────────────────────────────────────────────────
# PORT=8899
# HOST=127.0.0.1        # set 0.0.0.0 to listen on all interfaces (docker / LAN)
# DEEP_ENGINE=parallel  # switch the deep lane to Parallel.ai (~70s, better citations)
# PER_IP_DAY=25         # spend guard: checks per IP per day
# GLOBAL_DAY=400        # spend guard: checks per instance per day
# TRACK_EVERY_H=24      # how often tracked claims are re-checked

# ── Fully local setup (optional) ─────────────────────────────────────────────
# Any OpenAI-compatible server replaces Gemini: llama-swap, llama.cpp, Ollama, vLLM…
# When LLM_BASE_URL is set it takes precedence over GEMINI_API_KEY / Vertex.
# LLM_BASE_URL=http://192.168.1.10:8080/v1
# LLM_MODEL=qwen3-14b            # the model name from your llama-swap config.yaml
# LLM_API_KEY=                   # only if your server enforces a bearer token
# LLM_TIMEOUT=300                # seconds; first call may wait for a model swap
# LLM_MAX_TOKENS_MULT=1          # set 3–4 for a "thinking" model so reasoning fits
# LLM_PROVIDER_LABEL=llama-swap  # what the UI shows next to the blind-model verdict
#
# SearXNG replaces Exa + SerpAPI for the three web lanes (Grounded Web, Semantic Web,
# Live Index) and the fast Deep Research lane. The instance MUST expose the JSON API:
#   settings.yml → search: { formats: [html, json] }
# SEARXNG_URL=http://192.168.1.20:8080
# SEARXNG_ENGINES=google,bing,duckduckgo   # optional; default = instance defaults
# SEARXNG_LANGUAGE=all                     # optional
#
# Byparr (FlareSolverr-compatible headless browser) reads the pages that refuse a plain
# GET (Cloudflare & co.). Optional: without it those pages fall back to their snippet.
# BYPARR_URL=http://192.168.1.21:8191
# BYPARR_TIMEOUT=45              # seconds per page
# FETCH_BYPARR_MAX=4             # concurrent Byparr requests
